# Security scan reports — generated artifacts, never commit
reports/
# Exception: Next.js app route named 'reports' is source code, not a report artifact
!frontend/src/app/reports/

# TypeScript build cache — contains hashes, triggers false-positive secret scans
*.tsbuildinfo

# Environment — NEVER commit real secrets
.env
.env.local
.env.production
.env.staging

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# Node / Next.js
node_modules/
.next/
out/
.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
*.log

# Database
*.db
*.sqlite

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp

# Reports / Quarantine
quarantine/
reports/output/

# Security tools & venv
.venv-security/
.tools/
reports/*.json
reports/*.html
reports/*.txt
.secrets.baseline

# MCP / IDE tool configs (project-specific URLs, not secrets but not for sharing)
.mcp.json

# Coverage artifacts — generated by pytest --cov (not source code)
.coverage
backend/.coverage
htmlcov/
backend/htmlcov/
coverage.xml
backend/coverage.xml
coverage.json
backend/coverage.json
*.coverage

# Generated SQL migration dumps — run `alembic upgrade head --sql` to regenerate
# DO NOT commit: this file changes on every migration and is too large for diffs
backend/supabase_migrations.sql

# Playwright artifacts
frontend/playwright-report/
frontend/playwright-results.xml
frontend/playwright-artifacts/
frontend/test-results/
