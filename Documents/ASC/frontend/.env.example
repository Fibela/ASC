# ASC PremosCorp — Frontend Environment Variables
# Copy to .env.local and fill in values before running locally.
# NEVER commit .env.local to git.

# ASC FastAPI backend URL (no trailing slash)
# Local: http://localhost:8000
# Production: leave empty ("") — frontend and API are on the same Vercel domain
NEXT_PUBLIC_API_URL=http://localhost:8000

# PremosCorp portal URL — used to redirect SSO sessions back to re-authenticate
# on token expiry (instead of showing /login).
# Local: http://localhost:5173
# Production: https://premoscorp.com
NEXT_PUBLIC_PORTAL_URL=https://premoscorp.com
