# ─── ASC PremosCorp — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the values

# Backend
SECRET_KEY=generate-a-strong-random-key-here
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://asc_user:asc_pass@localhost:5432/asc_db
POSTGRES_DB=asc_db
POSTGRES_USER=asc_user
POSTGRES_PASSWORD=asc_pass

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# External threat intelligence (optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTXALIEN_API_KEY=

# SOC Thresholds
ALERT_CRITICAL_THRESHOLD=0.85
ALERT_HIGH_THRESHOLD=0.65
ALERT_MEDIUM_THRESHOLD=0.40
