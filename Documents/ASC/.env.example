# ─── ASC PremosCorp — Environment Variables ───────────────────────────────────
#
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  FASE 1 — DEPLOYMENT GRATUITO (actual)                              ║
# ║  PostgreSQL → Supabase free tier  (500 MB, sin costo)               ║
# ║  Backend   → Render free tier     (spin-down en inactividad)        ║
# ║  Frontend  → Vercel free tier                                       ║
# ║  Redis     → OPCIONAL (Celery desactivado hasta comercialización)   ║
# ╠══════════════════════════════════════════════════════════════════════╣
# ║  FASE 2 — DOCKER AUTO-HOSTING (cuando ASC sea rentable)             ║
# ║  Ver docs/deployment-guide.md → sección "Fase 2: Docker Compose"   ║
# ╚══════════════════════════════════════════════════════════════════════╝
#
# USAGE:
#   cp .env.example .env
#   $EDITOR .env           # fill in ALL values marked REQUIRED
#   chmod 600 .env         # restrict file permissions (Linux/Mac)
#
# SECURITY RULES:
#   • Never commit .env to git (it is in .gitignore)
#   • Never share this file publicly — it contains real secrets
#   • Rotate SECRET_KEY and DB passwords immediately if ever exposed
#   • Keep VIRUSTOTAL_API_KEY and other external keys secret
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ───────────────────────────────────────────────────────────────────

# REQUIRED — Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters. Never use the placeholder in production.
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_MIN_32_CHARS

# Set to "true" only in local development — NEVER in production
DEBUG=false

# Optional: your public domain (used in CORS_ORIGINS)
DOMAIN=asc.premoscorp.com

# ── PostgreSQL — FASE 1: Supabase free tier ───────────────────────────────────
#
# PASO 1: Crear proyecto en https://supabase.com (free, sin tarjeta)
# PASO 2: Project Settings → Database → Connection String → URI
#         Seleccionar "Mode: Session" (puerto 5432, compatible con asyncpg)
# PASO 3: Copiar la URL y sustituir [YOUR-PASSWORD] por la contraseña del proyecto
#
# Formato Supabase (directo, puerto 5432 — requerido para asyncpg):
#   postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# IMPORTANTE: usa puerto 5432 (Session mode), NO 6543 (Transaction mode/pgbouncer).
# asyncpg no es compatible con pgbouncer en transaction mode.
#
# Alternativa — si Supabase muestra host "db.[ref].supabase.co":
#   postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres
#
# SSL es obligatorio en Supabase (se negocia automáticamente con asyncpg).
DATABASE_URL=postgresql+asyncpg://postgres.REPLACE_REF:REPLACE_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── PostgreSQL — FASE 2: Docker Compose (auto-hosting) ────────────────────────
# Solo se usan cuando levantas docker-compose.yml.
# docker-compose construye DATABASE_URL a partir de estas variables.
# En Fase 1 (Supabase) estas variables son ignoradas.
POSTGRES_DB=asc_db
POSTGRES_USER=asc_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ── Redis — OPCIONAL hasta comercialización ────────────────────────────────────
#
# Sin Redis: Celery Beat no corre, las tareas periódicas (escalation,
# SLA checks, scheduled reports) están desactivadas. El resto del
# backend (API, SSE local mode, SPECTER, SOAR, playbooks) funciona
# completamente sin Redis.
#
# Con Redis (Fase 1 opcional): Upstash free tier — https://upstash.com
#   Free tier: 10,000 comandos/día, 256 MB. Suficiente para un SOC pequeño.
#   Formato: redis://default:[password]@[host].upstash.io:6379
#
# Con Redis (Fase 2 Docker): generado por docker-compose desde REDIS_PASSWORD.
#   Dejar vacío para desactivar Celery:
REDIS_URL=

# Solo para Fase 2 Docker Compose (Redis con --requirepass):
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. In production, only your domain.
# docker-compose sets this automatically — only override if needed.
CORS_ORIGINS=["http://localhost","https://asc.premoscorp.com"]

# ── Frontend ──────────────────────────────────────────────────────────────────
# In docker-compose production mode, this is set to "" (relative URLs via nginx).
# For local dev without Docker, set to the backend URL:
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── External Threat Intelligence (optional) ────────────────────────────────────
# Leave empty to disable the integration; ASC works without them.
# Keep these keys secret — they have billing implications if leaked.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTXALIEN_API_KEY=

# ── SOC Thresholds ─────────────────────────────────────────────────────────────
ALERT_CRITICAL_THRESHOLD=0.85
ALERT_HIGH_THRESHOLD=0.65
ALERT_MEDIUM_THRESHOLD=0.40

# ── P17 Hardening ──────────────────────────────────────────────────────────────
# Rate limiting — format: "N/period" (period: second/minute/hour)
# Reduce login limit in high-risk environments.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=30/minute
RATE_LIMIT_CHANGE_PASSWORD=10/minute

# SlowAPI Redis storage URI for multi-worker rate limit sharing.
# Empty = in-process memory (single-worker only).
# In production with multiple uvicorn workers, set this to a Redis URI.
SLOWAPI_STORAGE_URI=

# Maximum allowed request body in bytes (default 10 MB).
# Lower this if your API does not accept file uploads.
REQUEST_MAX_BODY_BYTES=10485760

# ── F1 — Palo Alto Networks PAN-OS ─────────────────────────────────────────────
# Leave empty to disable PAN-OS integration (ASC will use SPECTER agents only).
# PALOALTO_HOST: hostname or IP of Panorama/firewall — do NOT include https://
# PALOALTO_API_KEY: generate at Device → Administrators → Generate API Key
PALOALTO_HOST=
PALOALTO_API_KEY=
PALOALTO_VSYS=vsys1
PALOALTO_BLOCKED_IP_GROUP=ASC-Blocked-IPs
PALOALTO_BLOCKED_URL_CATEGORY=ASC-Blocked-Domains

# ── F1 — Fortinet FortiGate ─────────────────────────────────────────────────────
# Leave empty to disable FortiGate integration.
# FORTINET_HOST: hostname or IP of FortiGate — do NOT include https://
# FORTINET_API_TOKEN: generate at System → Administrators → REST API Admin
FORTINET_HOST=
FORTINET_API_TOKEN=
FORTINET_VDOM=root
FORTINET_BLOCKED_IP_GROUP=ASC-Blocked-IPs
FORTINET_BLOCKED_DOMAIN_GROUP=ASC-Blocked-Domains

# ── P39 — Observability / Prometheus ──────────────────────────────────────────
# Static bearer token for the Prometheus scraper at /api/v1/observability/metrics.
# If empty, the endpoint requires a standard JWT (analyst+ role).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Configure your Prometheus scrape_config with:
#   bearer_token: <this value>
METRICS_SCRAPE_TOKEN=

# ── F1 — Active Directory / LDAP ───────────────────────────────────────────────
# Leave empty to disable AD integration (accounts will only be disabled in ASC DB).
# AD_SERVER_URL: use LDAPS (port 636) in production — plain LDAP is insecure.
# AD_BIND_PASSWORD: use HashiCorp Vault or AWS Secrets Manager in production.
AD_SERVER_URL=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_BASE_DN=
AD_QUARANTINE_OU=
AD_USE_SSL=true
AD_VERIFY_CERT=true


# ── P53 — Email Verification ───────────────────────────────────────────────────
# Hours before the email verification token expires. Default: 24.
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# ── P55 — Stripe Billing ──────────────────────────────────────────────────────
# Leave empty to disable Stripe integration (billing metering still runs locally).
# STRIPE_SECRET_KEY: from Stripe Dashboard → API keys → Secret key
#   Production: sk_live_… | Test: sk_test_…
# STRIPE_WEBHOOK_SECRET: from Stripe Dashboard → Webhooks → Signing secret (whsec_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── SPECTER Signing Keys (Ed25519) ───────────────────────────────────────────
# Required in production for command signing between ASC and SPECTER agents.
# Leave empty in dev/sandbox — command signing is skipped.
# Generate with:
#   python -c "from app.core.signing import generate_keypair; p,q=generate_keypair(); print('PRIVATE:',p,'\nPUBLIC:',q)"
SPECTER_SIGNING_PRIVATE_KEY=
SPECTER_SIGNING_PUBLIC_KEY=

# ── P59 — SSO Bridge: Supabase → ASC JWT Exchange ────────────────────────────
# Required to enable SSO from premoscorp.com. Leave empty to disable SSO bridge.
# SUPABASE_URL: your project URL from Supabase Dashboard → Settings → API → URL
# SUPABASE_JWT_SECRET: from Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Plan assigned to auto-provisioned SSO tenants: free | pro | enterprise
SSO_DEFAULT_PLAN=free

# ── P60 — Stripe Checkout Auto-Provisioning ──────────────────────────────────
# Plan assigned when a Stripe checkout.session.completed fires (free|pro|enterprise)
STRIPE_PROVISIONING_PLAN=pro
# Optional: Stripe product ID for "SEGURIDAD" plan. Empty = all checkout events.
STRIPE_SEGURIDAD_PRODUCT_ID=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Required for email verification (P53 onboarding). Leave empty to disable emails.
# RESEND_API_KEY: from Resend Dashboard → API Keys
RESEND_API_KEY=

# ── Supabase Auth (additional keys) ─────────────────────────────────────────
# SUPABASE_ANON_KEY: public anon key (safe to expose) — from Supabase Dashboard → Settings → API
# SUPABASE_SERVICE_KEY: service_role key (keep secret!) — for server-to-server operations
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── SPECTER Enrollment Secret ─────────────────────────────────────────────────
# Required for SPECTER agent enrollment (P63). Used to derive enrollment tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SPECTER_ENROLLMENT_SECRET=

# ── Wazuh ────────────────────────────────────────────────────────────────────
# WAZUH_URL: Wazuh Manager REST API URL (e.g. https://wazuh.premoscorp.local:55000)
# WAZUH_USERNAME: Wazuh API user
# WAZUH_PASSWORD: Wazuh API password (sync:false — never log or expose)
WAZUH_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=

# ── ELK / Elasticsearch ───────────────────────────────────────────────────────
# ELASTICSEARCH_URL: e.g. https://elastic.premoscorp.local:9200
# ELASTICSEARCH_API_KEY: base64(id:api_key) from Kibana → API Keys
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# ── TheHive ──────────────────────────────────────────────────────────────────
# THEHIVE_URL: e.g. https://thehive.premoscorp.local:9000
# THEHIVE_API_KEY: TheHive API key (sync:false — never log or expose)
THEHIVE_URL=
THEHIVE_API_KEY=

# ── Vercel Cron Jobs ─────────────────────────────────────────────────────────
# CRON_SECRET: shared secret Vercel sends as "Authorization: Bearer <value>"
# when invoking cron endpoints. Set the same value in Vercel Dashboard.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# ── S102 Explicación adaptativa (Anthropic claude-fable-5) ────────────────
# Clave de la API de Anthropic. Vacío = módulo deshabilitado (endpoint 503).
# Ponerla SOLO en el Vercel Dashboard (Environment Variables), nunca en el repo.
# El módulo EXPLICA y RECOMIENDA; nunca decide ni ejecuta.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

